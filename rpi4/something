import time
import ctypes
import pyautogui

# Constants for Windows API
ES_CONTINUOUS = 0x80000000
ES_SYSTEM_REQUIRED = 0x00000001
ES_DISPLAY_REQUIRED = 0x00000002

def prevent_sleep():
    # Tells Windows to keep the system running and awake
    ctypes.windll.kernel32.SetThreadExecutionState(
        ES_CONTINUOUS | ES_SYSTEM_REQUIRED | ES_DISPLAY_REQUIRED
    )
    print("My test PC is like the devil. It never sleeps!")

def allow_sleep():
    # Reverts back to normal power state
    ctypes.windll.kernel32.SetThreadExecutionState(ES_CONTINUOUS)
    print("Power state restored.")

if __name__ == "__main__":
    prevent_sleep()
    try:
        while True:
            # Move the mouse 1 pixel right, then 1 pixel back left
            pyautogui.move(1, 0, duration=0.1)
            pyautogui.move(-1, 0, duration=0.1)
            
            # Wait for 120 seconds (2 minutes) before the next nudge
            time.sleep(120)
            
    except KeyboardInterrupt:
        allow_sleep()

